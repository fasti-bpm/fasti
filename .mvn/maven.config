-Dmaven.wagon.http.retryHandler.count=5
-Dmaven.wagon.http.retryHandler.requestSentEnabled=true
-Dmaven.wagon.httpconnectionManager.ttlSeconds=120
-Dmaven.wagon.http.serviceUnavailableRetryStrategy.class=standard
-Dmaven.wagon.http.serviceUnavailableRetryStrategy.maxRetries=5
-Dmaven.wagon.http.serviceUnavailableRetryStrategy.retryInterval=10000
-Daether.transport.http.retryHandler.count=5
-Daether.transport.http.retryHandler.interval=10000
-Daether.transport.http.retryHandler.intervalMax=120000
-Daether.transport.http.retryHandler.serviceUnavailable=429,503
-Daether.transport.http.connectionMaxTtl=120
-Daether.transport.apache.retryHandler.requestSentEnabled=true
