{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values of the Fasti BPM chart",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "production": {
      "type": "boolean",
      "description": "--production mode of the image"
    },
    "components": {
      "type": "object",
      "properties": {
        "webapps": {
          "type": "boolean"
        },
        "rest": {
          "type": "boolean"
        },
        "example": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^(jdbc:.*)?$"
        },
        "existingSecret": {
          "type": "string"
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "urlKey": {
          "type": "string"
        },
        "schemaUpdate": {
          "type": "boolean"
        },
        "schemaVersionCheck": {
          "type": "string",
          "enum": [
            "enforce",
            "warn"
          ]
        },
        "schema": {
          "type": "string"
        },
        "tablePrefix": {
          "type": "string"
        },
        "pool": {
          "type": "object",
          "properties": {
            "maxActive": {
              "description": "HikariCP maximum-pool-size",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]*)?$"
                }
              ]
            },
            "minIdle": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^([0-9]+)?$"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "waitFor": {
          "type": "string",
          "pattern": "^([^,\\s]+:[0-9]+)?(,[^,\\s]+:[0-9]+)*$"
        },
        "waitForTimeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "historyLevel": {
          "type": "string",
          "enum": [
            "",
            "none",
            "activity",
            "audit",
            "full",
            "auto"
          ]
        },
        "jobExecutor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "deploymentAware": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "webapp": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(/[^\\s]*)?$"
        },
        "legacyPathRedirect": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            true,
            false,
            "",
            "true",
            "false"
          ]
        },
        "classicWebapps": {
          "type": "boolean"
        },
        "corsAllowedOrigins": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "registrationId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "clientName": {
          "type": "string"
        },
        "issuerUri": {
          "type": "string",
          "pattern": "^(https?://.*)?$"
        },
        "clientId": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "clientSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userNameAttribute": {
          "type": "string",
          "minLength": 1
        },
        "groupsClaim": {
          "type": "string"
        },
        "adminGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groupMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "includeUnmappedGroups": {
          "type": "boolean"
        },
        "tenantsClaim": {
          "type": "string"
        },
        "identityProvider": {
          "type": "boolean"
        },
        "ssoLogout": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "postLogoutRedirectUri": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rest": {
          "type": "object",
          "properties": {
            "bearerEnabled": {
              "type": "boolean"
            },
            "issuerUri": {
              "type": "string",
              "pattern": "^(https?://.*)?$"
            },
            "audiences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "userIdClaim": {
              "type": "string",
              "minLength": 1
            },
            "groupsClaim": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "additional Spring Boot configuration (YAML)"
    },
    "jvm": {
      "type": "object",
      "properties": {
        "maxRamPercentage": {
          "type": ["integer", "null"],
          "minimum": 10,
          "maximum": 95
        },
        "javaOpts": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "required": [
          "name"
        ]
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "EnvFromSource list"
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Volume list"
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "VolumeMount list"
    },
    "initContainers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Container list"
    },
    "extraContainers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Container list"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "commonLabels": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "tmpVolume": {
      "type": "object",
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dataVolume": {
      "type": "object",
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "management": {
      "type": "object",
      "properties": {
        "port": {
          "description": "port of the actuator; empty: the HTTP port",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "not": {
                "enum": [
                  8080
                ]
              }
            },
            {
              "type": "string",
              "pattern": "^$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object"
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "podAntiAffinityPreset": {
      "type": "string",
      "enum": [
        "",
        "soft",
        "hard"
      ]
    },
    "affinity": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string"
          },
          "whenUnsatisfiable": {
            "type": "string",
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ]
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        },
        "sessionAffinity": {
          "type": "string",
          "enum": [
            "None",
            "ClientIP"
          ]
        },
        "sessionAffinityTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "nodePort": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^([0-9]+)?$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "hosts"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "description": "a number of pods, a percentage or empty",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^((100|[1-9]?[0-9])%)?$"
            }
          ]
        },
        "minAvailable": {
          "description": "a number of pods, a percentage or empty",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^((100|[1-9]?[0-9])%)?$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^$"
            }
          ]
        },
        "targetMemoryUtilizationPercentage": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^$"
            }
          ]
        },
        "behavior": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "port": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,13}[a-z0-9])?$"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        "extraPort": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,13}[a-z0-9])?$",
              "not": {
                "enum": [
                  "http",
                  "management"
                ]
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
