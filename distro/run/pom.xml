<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.fasti.platform</groupId>
    <artifactId>fasti-database-settings</artifactId>
    <version>1.0.1</version>
    <relativePath>../../database</relativePath>
  </parent>

  <groupId>dev.fasti.platform.run</groupId>
  <artifactId>fasti-bpm-run-root</artifactId>
  <name>Fasti BPM Platform - Run - Root</name>
  <description>
    This is the root of Camunda Platform Run.
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>
  <packaging>pom</packaging>

  <dependencyManagement>
    <dependencies>

      <!-- Jackson 2: imported before the Spring Boot BOM so that all distributions share ${version.jackson} -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${version.jackson}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>

      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${version.spring-boot}</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>

      <dependency>
        <groupId>org.graalvm.polyglot</groupId>
        <artifactId>js</artifactId>
        <type>pom</type>
        <version>${version.graal.js}</version>
      </dependency>

      <dependency>
        <groupId>org.graalvm.js</groupId>
        <artifactId>js-scriptengine</artifactId>
        <version>${version.graal.js}</version>
      </dependency>

      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>9.37.4</version>
      </dependency>

    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${version.spring-boot}</version>
        </plugin>
        <!-- JUnit Platform 6 (managed by Spring Boot 4) needs Surefire/Failsafe 3.x -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.version.surefire-boot}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${plugin.version.surefire-boot}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>

      <!-- Enforces Java 17 during the build -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <rules>
            <requireJavaVersion>
              <version>[17,)</version>
            </requireJavaVersion>
          </rules>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>distro</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>modules</module>
        <module>modules/rest</module>
        <module>modules/oauth2</module>
        <module>modules/example</module>
        <module>core</module>
        <module>assembly</module>
        <module>qa</module>
      </modules>
    </profile>
    <profile>
      <id>distro-ce</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <modules>
        <module>modules/webapps</module>
        <module>distro</module>
        <module>qa</module>
      </modules>
    </profile>
    <profile>
      <id>integration-test-camunda-run</id>
      <modules>
        <module>qa</module>
      </modules>
    </profile>
  </profiles>

</project>