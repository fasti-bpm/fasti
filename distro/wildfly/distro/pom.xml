<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.fasti.platform.wildfly</groupId>
    <artifactId>fasti-wildfly</artifactId>
    <version>1.3.2</version>
  </parent>

  <artifactId>fasti-bpm-wildfly</artifactId>
  <packaging>pom</packaging>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <name>Fasti BPM Platform - Wildfly Distro</name>

  <dependencies>
    <dependency>
      <!-- this dependency is to make sure that we are executed after the
        integration tests have passed in the reactor -->
      <groupId>dev.fasti.platform.qa</groupId>
      <artifactId>fasti-qa</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.wildfly</groupId>
      <artifactId>fasti-wildfly-assembly</artifactId>
      <version>${project.version}</version>
      <type>tar.gz</type>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.distro</groupId>
      <artifactId>fasti-sql-scripts</artifactId>
      <version>${project.version}</version>
      <type>jar</type>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform</groupId>
      <artifactId>fasti-engine-rest-jakarta</artifactId>
      <version>${project.version}</version>
      <classifier>wildfly</classifier>
      <type>war</type>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-wildfly</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.example</groupId>
      <artifactId>fasti-example-invoice-jakarta</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.8.0</version>
        <executions>
          <execution>
            <id>distro</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>assembly.xml</descriptor>
              </descriptors>
              <finalName>fasti-bpm-wildfly-${project.version}</finalName>
              <attach>true</attach>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>target/</outputDirectory>
              <workDirectory>target/assembly/work</workDirectory>
              <tarLongFileMode>gnu</tarLongFileMode>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
