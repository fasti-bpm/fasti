<module xmlns="urn:jboss:module:1.0" name="org.graalvm.js.js-scriptengine">
  <!-- All GraalJS jars (script engine, language, Truffle, polyglot SDK, shadowed ICU4J/XZ)
       live in this single module: Truffle locates the language and its runtime via
       ServiceLoader, which requires them to be visible to one class loader. -->
  <resources>
    <resource-root path="js-scriptengine-@version.graal.js@.jar" />
    <resource-root path="js-language-@version.graal.js@.jar" />
    <resource-root path="regex-@version.graal.js@.jar" />
    <resource-root path="icu4j-@version.graal.js@.jar" />
    <resource-root path="xz-@version.graal.js@.jar" />
    <resource-root path="polyglot-@version.graal.js@.jar" />
    <resource-root path="collections-@version.graal.js@.jar" />
    <resource-root path="nativeimage-@version.graal.js@.jar" />
    <resource-root path="word-@version.graal.js@.jar" />
    <resource-root path="truffle-api-@version.graal.js@.jar" />
    <resource-root path="truffle-runtime-@version.graal.js@.jar" />
    <resource-root path="truffle-compiler-@version.graal.js@.jar" />
    <resource-root path="jniutils-@version.graal.js@.jar" />
  </resources>

  <dependencies>
    <module name="javax.api" />
    <module name="sun.jdk" />
    <module name="org.camunda.spin.camunda-spin-core" />
  </dependencies>
</module>
