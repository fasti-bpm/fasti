<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- Fasti: open tasks grouped by assignee and by candidate group. The tasks are selected by the
  statement of the task query, so its criteria, authorization check and tenant check apply
  unchanged; the statements here only group what it selects. They read ACT_RU_* tables only. -->
<mapper namespace="dev.fasti.engine.workload.impl.TaskLoadEntity">

  <resultMap id="taskLoadResultMap" type="dev.fasti.engine.workload.impl.TaskLoadEntity">
    <result property="id" column="KEY_" jdbcType="VARCHAR" />
    <result property="open" column="OPEN_" jdbcType="BIGINT" />
    <result property="unassigned" column="UNASSIGNED_" jdbcType="BIGINT" />
    <result property="overdue" column="OVERDUE_" jdbcType="BIGINT" />
    <result property="oldest" column="OLDEST_" jdbcType="TIMESTAMP" />
  </resultMap>

  <!-- every task once, although the joins of the task query may repeat it -->
  <sql id="selectedTasks">
    (
      select distinct RES.ID_, RES.ASSIGNEE_, RES.DUE_DATE_, RES.CREATE_TIME_
      <include refid="org.camunda.bpm.engine.impl.persistence.entity.TaskEntity.selectTaskByQueryCriteriaSql" />
    ) T
  </sql>

  <select id="selectFastiTaskLoadTotals" parameterType="dev.fasti.engine.workload.impl.WorkloadTaskQuery" resultMap="taskLoadResultMap">
    select
      count(T.ID_) as OPEN_,
      sum(case when T.ASSIGNEE_ is null then 1 else 0 end) as UNASSIGNED_,
      sum(case when T.DUE_DATE_ &lt; #{loadOverdueBefore} then 1 else 0 end) as OVERDUE_,
      min(T.CREATE_TIME_) as OLDEST_
    from
    <include refid="selectedTasks" />
  </select>

  <select id="selectFastiTaskLoadByAssignee" parameterType="dev.fasti.engine.workload.impl.WorkloadTaskQuery" resultMap="taskLoadResultMap">
    select
      T.ASSIGNEE_ as KEY_,
      count(T.ID_) as OPEN_,
      0 as UNASSIGNED_,
      sum(case when T.DUE_DATE_ &lt; #{loadOverdueBefore} then 1 else 0 end) as OVERDUE_,
      min(T.CREATE_TIME_) as OLDEST_
    from
    <include refid="selectedTasks" />
    group by T.ASSIGNEE_
  </select>

  <!-- a task offered to several of the groups counts for each of them; one offered to the same
    group twice counts once -->
  <select id="selectFastiTaskLoadByCandidateGroup" parameterType="dev.fasti.engine.workload.impl.WorkloadTaskQuery" resultMap="taskLoadResultMap">
    select
      L.GROUP_ID_ as KEY_,
      count(distinct T.ID_) as OPEN_,
      count(distinct case when T.ASSIGNEE_ is null then T.ID_ end) as UNASSIGNED_,
      count(distinct case when T.DUE_DATE_ &lt; #{loadOverdueBefore} then T.ID_ end) as OVERDUE_,
      min(T.CREATE_TIME_) as OLDEST_
    from
    <include refid="selectedTasks" />
    inner join ${prefix}ACT_RU_IDENTITYLINK L on L.TASK_ID_ = T.ID_
    where L.TYPE_ = 'candidate'
      and L.GROUP_ID_ in
      <foreach item="loadGroupId" collection="loadGroupIds" open="(" separator="," close=")">
        #{loadGroupId}
      </foreach>
    group by L.GROUP_ID_
  </select>

</mapper>
