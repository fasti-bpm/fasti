<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.fasti.platform</groupId>
    <artifactId>fasti-database-settings</artifactId>
    <relativePath>../database</relativePath>
    <version>1.3.1</version>
  </parent>

  <artifactId>fasti-bpm-quarkus-parent</artifactId>
  <groupId>dev.fasti.platform.quarkus</groupId>

  <name>Fasti BPM Platform - Quarkus Extension - Parent</name>

  <packaging>pom</packaging>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${version.quarkus}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <redirectTestOutputToFile>true</redirectTestOutputToFile>
            <skipTests>true</skipTests>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <!-- In a source checkout, the Quarkus test bootstrap finds the juel module in the
                Maven workspace and loads its target/classes, which still use jakarta.el; the
                engine is compiled against the relocated org.camunda.bpm.impl.juel.jakarta.el of
                the shaded fasti-juel jar (VerifyError in JuelExpressionManager). Loading
                fasti-juel parent-first takes it from the test classpath, the shaded jar, as an
                application does. -->
              <quarkus.class-loading.parent-first-artifacts>dev.fasti.platform.juel:fasti-juel</quarkus.class-loading.parent-first-artifacts>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <modules>
    <module>engine</module>
  </modules>

  <profiles>
    <profile>
      <id>quarkus-tests</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <skipTests>false</skipTests>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>