<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- HEADS-UP: Do not use fasti-parent as parent,
  it would introduce a cyclic dependency to this bom -->
  <parent>
    <groupId>dev.fasti.platform</groupId>
    <artifactId>fasti-root</artifactId>
    <version>1.3.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <groupId>dev.fasti.platform.spin</groupId>
  <artifactId>fasti-spin-bom</artifactId>
  <name>Fasti BPM Platform - spin - bom</name>
  <version>1.3.1</version>
  <packaging>pom</packaging>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <dependencyManagement>
    <dependencies>

      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      
      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-core</artifactId>
        <type>test-jar</type>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-dataformat-all</artifactId>
        <version>${project.version}</version>
        <!-- Excluding dependencies that are shaded in fasti-spin-dataformat-all -->
        <exclusions>
          <exclusion>
            <groupId>dev.fasti.platform.spin</groupId>
            <artifactId>fasti-spin-dataformat-json-jackson</artifactId>
          </exclusion>
          <exclusion>
            <groupId>dev.fasti.platform.spin</groupId>
            <artifactId>fasti-spin-dataformat-xml-dom</artifactId>
          </exclusion>
          <exclusion>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
          </exclusion>
          <exclusion>
            <groupId>com.sun.xml.bind</groupId>
            <artifactId>jaxb-impl</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-dataformat-json-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-dataformat-xml-dom</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>dev.fasti.platform.spin</groupId>
        <artifactId>fasti-spin-dataformat-xml-dom-jakarta</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
