<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <parent>
    <groupId>dev.fasti.platform.springboot.project</groupId>
    <artifactId>fasti-bpm-spring-boot-starter-root</artifactId>
    <version>1.0.1</version>
  </parent>

  <groupId>dev.fasti.platform.springboot</groupId>
  <artifactId>fasti-bpm-spring-boot-starter-security</artifactId>
  <name>Fasti BPM Platform - Spring Boot Starter - Spring Security</name>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fasti-bpm-spring-boot-starter</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fasti-bpm-spring-boot-starter-webapp</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fasti-bpm-spring-boot-starter-rest</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- spring security dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
    </dependency>
    <!-- bearer tokens on the REST API (JWT resource server) -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <!-- claim mapping and checks of the login endpoints, shared with Tomcat and WildFly;
           its Nimbus libraries are those of Spring Security already -->
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-oidc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>fasti-bpm-spring-boot-starter-test</artifactId>
      <groupId>${project.groupId}</groupId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${version.httpclient5}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @AutoConfigureMockMvc moved to spring-boot-webmvc-test in Spring Boot 4 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.fasti.platform.commons</groupId>
      <artifactId>fasti-commons-testing</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
