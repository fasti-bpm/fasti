<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <parent>
    <groupId>dev.fasti.platform.springboot.project</groupId>
    <artifactId>fasti-bpm-spring-boot-starter-root</artifactId>
    <version>1.2.1</version>
  </parent>

  <groupId>dev.fasti.platform.springboot</groupId>
  <artifactId>fasti-bpm-spring-boot-starter-webapp-core</artifactId>
  <name>Fasti BPM Platform - Spring Boot Starter - Webapps Core</name>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fasti-bpm-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-jakarta</artifactId>
      <type>jar</type>
      <classifier>classes</classifier>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-webjar</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jersey</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <artifactId>fasti-bpm-spring-boot-starter-test</artifactId>
      <groupId>${project.groupId}</groupId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
      <version>${version.mockito}</version>
    </dependency>

  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <!-- See CAM-11901 -->
            <useManifestOnlyJar>false</useManifestOnlyJar>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
