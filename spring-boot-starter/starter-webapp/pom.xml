<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <description>
    Part of Fasti BPM, an independent open source BPM platform built on Camunda 7 Community Edition 7.24.0.
  </description>

  <parent>
    <groupId>dev.fasti.platform.springboot.project</groupId>
    <artifactId>fasti-bpm-spring-boot-starter-root</artifactId>
    <version>1.2.1</version>
  </parent>

  <groupId>dev.fasti.platform.springboot</groupId>
  <artifactId>fasti-bpm-spring-boot-starter-webapp</artifactId>
  <name>Fasti BPM Platform - Spring Boot Starter - Webapps</name>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>fasti-bpm-spring-boot-starter-webapp-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <artifactId>fasti-bpm-spring-boot-starter-test</artifactId>
      <groupId>${project.groupId}</groupId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-webjar</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <!-- Maven Central release (profile "central" of the root POM): this module has no Java
           sources, so Central's required sources and javadoc jars are placeholders with a README. -->
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>placeholder-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>sources</classifier>
                  <classesDirectory>${maven.multiModuleProjectDirectory}/build-config/central-placeholder</classesDirectory>
                </configuration>
              </execution>
              <execution>
                <id>placeholder-javadoc</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>javadoc</classifier>
                  <classesDirectory>${maven.multiModuleProjectDirectory}/build-config/central-placeholder</classesDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
