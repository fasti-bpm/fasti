<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="defs_e2e_migrate" targetNamespace="http://fasti.dev/e2e">
  <bpmn:process id="e2e_migrate" name="E2E migrate" isExecutable="true" camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="start" name="Start" camunda:initiator="initiator" />
    <bpmn:userTask id="stepA" name="Step A v2" camunda:assignee="${initiator}" />
    <bpmn:sequenceFlow id="flow1" sourceRef="start" targetRef="stepA" />
    <bpmn:userTask id="stepB" name="Step B v2" camunda:assignee="${initiator}" />
    <bpmn:sequenceFlow id="flow2" sourceRef="stepA" targetRef="stepB" />
    <bpmn:userTask id="stepC" name="Step C" camunda:assignee="${initiator}" />
    <bpmn:sequenceFlow id="flow3" sourceRef="stepB" targetRef="stepC" />
    <bpmn:endEvent id="end" name="End"  />
    <bpmn:sequenceFlow id="flow4" sourceRef="stepC" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_e2e_migrate">
    <bpmndi:BPMNPlane id="plane_e2e_migrate" bpmnElement="e2e_migrate">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="150" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="stepA_di" bpmnElement="stepA"><dc:Bounds x="246" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1"><di:waypoint x="186" y="120" /><di:waypoint x="246" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="stepB_di" bpmnElement="stepB"><dc:Bounds x="406" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2"><di:waypoint x="346" y="120" /><di:waypoint x="406" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="stepC_di" bpmnElement="stepC"><dc:Bounds x="566" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3"><di:waypoint x="506" y="120" /><di:waypoint x="566" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="726" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow4_di" bpmnElement="flow4"><di:waypoint x="666" y="120" /><di:waypoint x="726" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
