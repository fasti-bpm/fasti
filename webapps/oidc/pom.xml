<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.fasti.platform.webapp</groupId>
    <artifactId>fasti-webapp-root</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../</relativePath>
  </parent>

  <artifactId>fasti-webapp-oidc</artifactId>
  <name>Fasti BPM Platform - Webapp - OpenID Connect</name>
  <description>
    Single sign-on (OpenID Connect) for the web applications and bearer tokens for the REST API
    in a servlet container (Tomcat, WildFly), configured through a properties file.
  </description>

  <properties>
    <version.nimbus-oauth2-oidc-sdk>11.38.2</version.nimbus-oauth2-oidc-sdk>
    <version.nimbus-jose-jwt>10.9.1</version.nimbus-jose-jwt>
    <!-- generate a bom of compile time dependencies for the license book -->
    <skip-third-party-bom>false</skip-third-party-bom>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>jakarta.platform</groupId>
        <artifactId>jakarta.jakartaee-bom</artifactId>
        <version>${version.jakarta-ee-spec}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>oauth2-oidc-sdk</artifactId>
      <version>${version.nimbus-oauth2-oidc-sdk}</version>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${version.nimbus-jose-jwt}</version>
    </dependency>
    <!-- used by json-smart (via accessors-smart) of the Nimbus libraries; declared here so
         that the version applies to every module that bundles this one -->
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.9.1</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>dev.fasti.platform</groupId>
      <artifactId>fasti-engine-rest-core-jakarta</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>dev.fasti.platform.webapp</groupId>
      <artifactId>fasti-webapp-jakarta</artifactId>
      <version>${project.version}</version>
      <classifier>classes</classifier>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <version>${version.spring.framework6}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <version>${version.spring.framework6}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>${version.spring.framework6}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
